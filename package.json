{
  "name": "timed-automata-analysis",
  "private": true,
  "version": "3.0.2",
  "type": "module",
  "scripts": {
    "start": "vite",
    "clean": "node -e \"['dist', 'playwright-report', 'test-results'].forEach(p => fs.rmSync(p, { recursive: true, force: true }))\"",
    "build": "tsc && vite build",
    "format": "prettier --write \"./**/*.{css,html,js,cjs,json,md,ts,tsx,yaml}\"",
    "lint": "eslint . --fix --report-unused-disable-directives",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e-ui": "playwright test --ui",
    "e2e-update-snapshots": "playwright test --update-snapshots",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "timed-automata-analyzer": "1.1.1",
    "vis-data": "8.0.4",
    "vis-network": "10.1.0"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.6.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/vis": "4.21.27",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "nano-staged": "1.0.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.10"
  },
  "nano-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --report-unused-disable-directives --max-warnings 0"
    ],
    "*.{css,html,js,cjs,json,md,yaml}": "prettier --write"
  }
}
